{
	"name" : "simondest/contact-bundle",
	"type" : "symfony-bundle",
	"description" : "Implementation of a contact form for Symfony3",
	"keywords" : [
		"Symfony3",
		"Symfony2",
		"contact",
		"form"
	],
	"homepage" : "https://github.com/simondest/ContactBundle",
	"license" : "MIT",
	"authors" : [{
			"name" : "SimonDest",
			"email" : ""
		}
	],
	"require" : {
		"php" : ">=5.5.0",
		"swiftmailer/swiftmailer" : "~4.3|~5",
		"symfony/form" : "~2.8|~3.0",
		"symfony/framework-bundle" : "~2.8|~3.0",
		"twig/twig" : "~1.20|~2.0"
	},
	"require-dev" : {
		"fabpot/php-cs-fixer" : "~0.1|~1.0",
		"phpunit/phpunit" : "~4.8",
		"symfony/phpunit-bridge" : "~2.8|~3.0"
	},
	"suggest" : {
		"mremi/templating-extra-bundle" : "In order to profile pages, get some statistics and enhance front office development"
	},
	"autoload" : {
		"psr-0" : {
			"Vertacoo\\ContactBundle" : ""
		}
	},
	"target-dir" : "Vertacoo/ContactBundle"
}